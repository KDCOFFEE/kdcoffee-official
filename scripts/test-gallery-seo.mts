import {DEFAULT_SOCIAL_IMAGE} from '../lib/socialMetadata';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import {execFileSync} from 'node:child_process';import {createElement} from 'react';import {renderToStaticMarkup} from 'react-dom/server';
import Gallery from '../components/gallery/GalleryExperience';import {resolveGalleryWorks} from '../lib/galleryWorks';import {galleryMetadata,galleryStructuredData,serializeGalleryStructuredData,GALLERY_SEO_DESCRIPTION,GALLERY_SEO_TITLE} from '../lib/gallerySeo';
const site=JSON.parse(await fs.readFile('public/data/website-data.json','utf8')),works=resolveGalleryWorks(site.menu.products),origin='https://www.kdcoffee1962.com';let count=0;const test=(name:string,fn:()=>void)=>{fn();count++;console.log('PASS '+name);};
test('metadata uses absolute title, index/follow and one query-independent canonical',()=>{const m=galleryMetadata(origin);assert.deepEqual(m.title,{absolute:GALLERY_SEO_TITLE});assert.deepEqual(m.alternates,{canonical:origin+'/gallery'});assert.deepEqual(m.robots,{index:true,follow:true});assert.ok(Array.from(GALLERY_SEO_DESCRIPTION).length>=80&&Array.from(GALLERY_SEO_DESCRIPTION).length<=150);});
test('existing active brand asset supplies consistent social image',()=>{const m=galleryMetadata(origin,{status:'active',path:'/uploads/assets/logo/brand.png'});assert.ok(JSON.stringify(m.openGraph).includes(origin+'/uploads/assets/logo/brand.png'));assert.ok(JSON.stringify(m.twitter).includes('summary_large_image'));for(const path of ['/private/member.png','https://bad.example/image.png','/uploads/assets/../private.png','/uploads/assets/%2e%2e/x.png'])assert.ok(JSON.stringify(galleryMetadata(origin,{status:'active',path}).openGraph).includes(DEFAULT_SOCIAL_IMAGE.url));});
test('CollectionPage ItemList contains exactly current public works and real detail URLs',()=>{const j=galleryStructuredData(origin,works);assert.equal(j['@type'],'CollectionPage');assert.equal(j.mainEntity['@type'],'ItemList');assert.equal(j.mainEntity.numberOfItems,works.length);assert.equal(j.mainEntity.itemListElement.length,8);j.mainEntity.itemListElement.forEach((item,i)=>{assert.equal(item.position,i+1);assert.equal(item.url,origin+'/works/'+works[i].slug);});for(const p of site.menu.products.filter((p:{status:string})=>p.status==='hidden'||p.status==='coming_soon'))assert.ok(!JSON.stringify(j).includes(p.slug));assert.ok(!JSON.stringify(j).includes('VideoObject'));});
test('JSON-LD serializer prevents script termination and retains valid JSON',()=>{const x={name:'</script><script>alert(1)</script>&'};const text=serializeGalleryStructuredData(x);assert.ok(!text.includes('<'));assert.deepEqual(JSON.parse(text),x);});
test('SSR visible Collection Index has actual links for all public works without noscript dependence',()=>{const html=renderToStaticMarkup(createElement(Gallery,{works}));for(const work of works)assert.ok(html.includes('href="/works/'+work.slug+'"'));assert.ok(!html.includes('<noscript>'));for(const p of site.menu.products.filter((p:{status:string})=>p.status==='hidden'))assert.ok(!html.includes(p.slug));});
const sitemapSource=await fs.readFile('app/sitemap.ts','utf8'),robotsSource=await fs.readFile('app/robots.ts','utf8');
test('Gallery sitemap and robots protect public discovery',()=>{assert.ok(sitemapSource.includes('"/gallery"'));assert.ok(robotsSource.includes('allow: "/"'));assert.ok(robotsSource.includes('"/admin"'));assert.ok(!robotsSource.includes('"/uploads/"'));});
test('Gallery Header preserves current baseline public projection',()=>{assert.equal(execFileSync('git',['diff','--','components/layout/Header.tsx'],{encoding:'utf8'}),'');});
console.log('GALLERY SEO '+count+' PASS; live HTML verified separately.');
