import assert from 'node:assert/strict';
import {promises as fs} from 'node:fs';
import os from 'node:os';import path from 'node:path';
import {createElement} from 'react';import {renderToStaticMarkup} from 'react-dom/server';
import {validateLineCardOverride,resolveLineCardConfig,cardDefaults,type LineCardOverride} from '../lib/lineCardConfiguration';
import {getLineCardConfigFile,readLineCardConfig,writeLineCardConfig,LineCardConflictError,LineCardStorageError} from '../lib/lineCardConfigStore';
import {renderLineFlex} from '../lib/lineFlexRenderer';
import {composeLineCard} from '../lib/lineCardPresentation';
import {LINE_CARD_CATALOG} from '../lib/lineNotificationCardCatalog';
import Editor from '../components/admin/LineNotificationCardEditor';
import {GET,PUT} from '../app/api/admin/notifications/line-cards/route';
import {adminCookieName,createAdminSessionValue} from '../lib/adminAuth';

const root=await fs.mkdtemp(path.join(os.tmpdir(),'kd-j6g3-unit-'));process.env.KD_DATA_DIR=root;process.env.ADMIN_SESSION_SECRET='j6g3-isolated-unit-auth-secret-long-2026';
let checks=0;const check=async(name:string,fn:()=>void|Promise<void>)=>{await fn();checks++;console.log('PASS '+name);};
const event='customer.return.refund_completed',other='customer.order.confirmed';
const globals=globalThis as typeof globalThis&{__returnCookies?:Record<string,string>};
const owner=()=>{globals.__returnCookies={[adminCookieName]:createAdminSessionValue({role:'owner',adminId:'owner'})};};
const request=(body:unknown,headers:Record<string,string>={})=>new Request('http://localhost:3195/api/admin/notifications/line-cards',{method:'PUT',headers:{'Content-Type':'application/json',Origin:'http://localhost:3195',...headers},body:JSON.stringify(body)});
await check('absent configuration returns defaults without initializing a file',async()=>{assert.equal((await readLineCardConfig()).revision,0);await assert.rejects(fs.access(getLineCardConfigFile()));assert.equal(resolveLineCardConfig(event).copy.title,cardDefaults(event).title);});
let store=await readLineCardConfig();
for(const [field,value]of Object.entries({displayName:'退款通知範例',title:'退款辦理完成',intro:'訂單 {{orderNumber}} 的退款資訊已更新。',secondaryText:'請至會員中心查看紀錄。',ctaLabel:'查看退款明細',altText:'KD Coffee｜退款資訊',footerText:'KD Coffee 為您服務',headerAsset:'REWARD'}))await check('persist '+field+' across reload',async()=>{store=await writeLineCardConfig({eventKey:event,action:'save',expectedRevision:store.revision,actor:'owner',overrides:{...store.events[event]?.overrides,[field]:value}});assert.equal((await readLineCardConfig()).events[event].overrides[field as keyof LineCardOverride],value);});
await check('only overrides and trusted actor/time persist',async()=>{const raw=JSON.parse(await fs.readFile(getLineCardConfigFile(),'utf8'));assert.equal(raw.version,1);assert.equal(raw.events[event].updatedBy,'owner');assert.ok(Date.parse(raw.events[event].updatedAt));assert.ok(!raw.events[other]);assert.equal(Object.keys(raw.events[event].overrides).length,8);assert.ok(!JSON.stringify(raw).includes('refundAmount'));});
await check('saved copy shares the semantic renderer and static asset registry',()=>{const def=LINE_CARD_CATALOG.find(d=>d.eventKey===event)!;const r=renderLineFlex(event,def.previewSample,undefined,store.events[event].overrides);assert.ok(r.ok);if(r.ok){assert.equal(r.card.title,'退款辦理完成');assert.equal(composeLineCard(r.card).imagePath,'/images/line-cards/reward.jpg');assert.ok(r.plainTextFallback.includes('KD20261031-1234'));assert.ok(r.plainTextFallback.includes('NT$500'));assert.equal(r.card.status.label,'已完成');assert.ok(r.card.cta.url.endsWith('/returns'));}});
await check('another event remains unchanged and defaults are not duplicated',async()=>{const defaults=cardDefaults(other);store=await writeLineCardConfig({eventKey:other,action:'save',expectedRevision:store.revision,actor:'owner',overrides:{...defaults,title:'訂單確認資訊'}});assert.deepEqual(store.events[other].overrides,{title:'訂單確認資訊'});assert.equal(store.events[event].overrides.title,'退款辦理完成');});
await check('stale revision cannot overwrite another event',async()=>{await assert.rejects(writeLineCardConfig({eventKey:other,action:'save',expectedRevision:0,actor:'owner',overrides:{title:'過時文字'}}),LineCardConflictError);assert.equal((await readLineCardConfig()).events[other].overrides.title,'訂單確認資訊');});
await check('restore removes exactly one event including its image override',async()=>{store=await writeLineCardConfig({eventKey:event,action:'restore',expectedRevision:store.revision,actor:'owner'});assert.ok(!store.events[event]);assert.equal(store.events[other].overrides.title,'訂單確認資訊');assert.equal(resolveLineCardConfig(event).headerAsset,undefined);});
for(const key of ['status','orderNumber','amount','refundAmount','creditAmount','points','expiresOn','trackingNumber','memberName','ctaUrl','bankAccount','refundProof','token','fingerprint','updatedBy','__proto__'])await check('reject protected/unknown field '+key,()=>assert.throws(()=>validateLineCardOverride(event,JSON.parse('{"'+key+'":"unsafe"}'))));
for(const value of ['{{bankAccount}}','{{process.env.SECRET}}','{{orderNumber.constructor}}','{{unknown}}','{{orderNumber + 1}}','{{orderNumber}'])await check('reject unsafe placeholder '+value,()=>assert.throws(()=>validateLineCardOverride(event,{intro:value})));
await check('length, empty title/alt and unknown assets fail validation',()=>{for(const overrides of [{title:''},{altText:''},{ctaLabel:'字'.repeat(21)},{intro:'字'.repeat(241)},{headerAsset:'https://evil.test/a.jpg'},{headerAsset:'../private'},{title:123}])assert.throws(()=>validateLineCardOverride(event,overrides));assert.throws(()=>validateLineCardOverride('unknown',{}));});
await check('new/no-override events all retain valid render coverage',()=>{for(const def of LINE_CARD_CATALOG)assert.ok(renderLineFlex(def.eventKey,def.previewSample).ok);});
await check('editor has safe controls, sample live preview, compare and fallback',()=>{const html=renderToStaticMarkup(createElement(Editor,{eventKey:event,store,onDirty:()=>{},onSaved:()=>{},onClose:()=>{}}));for(const text of ['卡片名稱','卡片標題','上方說明','補充說明','按鈕文字','LINE altText','頁尾文字','抬頭圖片','儲存卡片設定','恢復預設文案','比較預設','純文字 fallback 預覽','{{refundAmount}}'])assert.ok(html.includes(text));assert.ok(!html.includes('name="status"'));assert.ok(html.includes('accept="image/jpeg,image/png,image/webp"'));});
await check('unauthenticated GET and mutation rejected before any config read',async()=>{globals.__returnCookies={};assert.equal((await GET()).status,401);assert.equal((await PUT(request({action:'save',eventKey:event,expectedRevision:store.revision,overrides:{title:'禁止'}}))).status,401);});
await check('non-owner Admin cannot read or write',async()=>{globals.__returnCookies={[adminCookieName]:createAdminSessionValue({role:'admin',adminId:'staff'})};assert.equal((await GET()).status,403);assert.equal((await PUT(request({action:'restore',eventKey:event,expectedRevision:store.revision}))).status,403);});
owner();
await check('cross-origin/cross-site and non-JSON mutations rejected',async()=>{const body={action:'restore',eventKey:event,expectedRevision:store.revision};assert.equal((await PUT(request(body,{Origin:'https://evil.test'}))).status,403);assert.equal((await PUT(request(body,{'sec-fetch-site':'cross-site'}))).status,403);assert.equal((await PUT(request(body,{'Content-Type':'text/plain'}))).status,415);});
await check('oversized JSON, unknown envelope and malformed JSON rejected',async()=>{assert.equal((await PUT(request({padding:'x'.repeat(17000)}))).status,413);assert.equal((await PUT(request({action:'save',eventKey:event,expectedRevision:store.revision,overrides:{},actor:'forged'}))).status,400);assert.equal((await PUT(new Request('http://localhost:3195/api/admin/notifications/line-cards',{method:'PUT',headers:{'Content-Type':'application/json'},body:'{bad'}))).status,400);});
await check('authenticated save/read/restore through actual API',async()=>{let response=await PUT(request({action:'save',eventKey:event,expectedRevision:store.revision,overrides:{title:'隔離 API 測試',headerAsset:'ORDER'}}));assert.equal(response.status,200);store=await response.json();const saved=await (await GET()).json();assert.equal(saved.events[event].overrides.title,'隔離 API 測試');response=await PUT(request({action:'restore',eventKey:event,expectedRevision:store.revision}));assert.equal(response.status,200);store=await response.json();assert.ok(!store.events[event]);assert.ok(store.events[other]);});
await check('malformed persisted domain fails closed and is not overwritten',async()=>{const file=path.join(root,'corrupt.json');await fs.writeFile(file,'{broken');await assert.rejects(readLineCardConfig(file),LineCardStorageError);await assert.rejects(writeLineCardConfig({filePath:file,eventKey:event,action:'save',expectedRevision:0,actor:'owner',overrides:{title:'禁止覆寫'}}),LineCardStorageError);assert.equal(await fs.readFile(file,'utf8'),'{broken');});
await check('parallel writers cannot lose an update',async()=>{const file=path.join(root,'parallel.json');const results=await Promise.allSettled([writeLineCardConfig({filePath:file,eventKey:event,action:'save',expectedRevision:0,actor:'owner',overrides:{title:'視窗 A'}}),writeLineCardConfig({filePath:file,eventKey:other,action:'save',expectedRevision:0,actor:'owner',overrides:{title:'視窗 B'}})]);assert.equal(results.filter(r=>r.status==='fulfilled').length,1);assert.equal(results.filter(r=>r.status==='rejected'&&r.reason instanceof LineCardConflictError).length,1);assert.equal((await readLineCardConfig(file)).revision,1);});
await check('accessors and non-serializable override inputs fail before evaluation',()=>{let called=false;const obj={};Object.defineProperty(obj,'title',{get(){called=true;return 'unsafe';}});assert.throws(()=>validateLineCardOverride(event,obj));assert.equal(called,false);for(const input of [[],new Date(),{title:()=>{}},{intro:null}])assert.throws(()=>validateLineCardOverride(event,input));});
console.log('J6G3 '+checks+' persistence/editor/security checks PASS; isolated root '+root+'; no external sends.');
