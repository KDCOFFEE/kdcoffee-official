import assert from 'node:assert/strict';import fs from 'node:fs/promises';import {createElement} from 'react';import {renderToStaticMarkup} from 'react-dom/server';import * as nodeModule from 'node:module';
const {stripTypeScriptTypes}=nodeModule as unknown as {stripTypeScriptTypes:(code:string,options:{mode:'transform'})=>string};
import {normalizeGallerySeo,resolveGallerySeo,GALLERY_SEO_TITLE,GALLERY_SEO_DESCRIPTION} from '../lib/gallerySeoSettings';import {galleryMetadata,galleryStructuredData,resolveGallerySeoImage} from '../lib/gallerySeo';import {resolveGalleryWorks} from '../lib/galleryWorks';import Controls from '../components/admin/GallerySeoControls';import type {AssetRecord} from '../lib/assets';
let count=0;function test(name:string,fn:()=>void){fn();count++;console.log('PASS '+name);}
const logo={id:'LOGO001',status:'active',path:'/uploads/assets/logo/brand.png',alt:'KD Coffee'} as AssetRecord,selected={id:'ART',status:'active',path:'/uploads/artworks/work/art.webp',alt:'作品'} as AssetRecord;
test('missing and empty settings use approved defaults and social fallbacks',()=>{for(const value of [undefined,{}, {title:' ',description:'',ogTitle:'',ogDescription:'',ogImageAssetId:''}]){const s=resolveGallerySeo(value);assert.equal(s.title,GALLERY_SEO_TITLE);assert.equal(s.description,GALLERY_SEO_DESCRIPTION);assert.equal(s.ogTitle,s.title);assert.equal(s.ogDescription,s.description);}});
test('configured main copy feeds social fallback and independent overrides',()=>{const value={title:'新的搜尋標題',description:'新的搜尋描述'};assert.equal(resolveGallerySeo(value).ogTitle,value.title);assert.equal(resolveGallerySeo({...value,ogTitle:'分享標題'}).ogTitle,'分享標題');assert.equal(resolveGallerySeo({...value,ogDescription:'分享摘要'}).ogDescription,'分享摘要');});
test('guidance is advisory and accepted text is never truncated',()=>{const title='字'.repeat(100),description='文'.repeat(300);assert.deepEqual(normalizeGallerySeo({title,description}),{title,description});assert.throws(()=>normalizeGallerySeo({title:'字'.repeat(201)}));assert.equal(title.length,100);});
test('infra fields, markup and malformed values cannot be persisted',()=>{for(const value of [null,[],{canonical:'https://bad.example'},{robots:'noindex'},{jsonLd:{}},{title:1},{description:'<script>'},{ogImageAssetId:'../private'}])assert.throws(()=>normalizeGallerySeo(value));});
test('valid existing asset selected; missing deleted/private asset safely falls back',()=>{assert.equal(resolveGallerySeoImage({ogImageAssetId:'ART'},[selected],logo)?.path,selected.path);for(const assets of [[],[{...selected,status:'missing'} as AssetRecord],[{...selected,path:'/uploads/order-notifications/private.webp'}]])assert.equal(resolveGallerySeoImage({ogImageAssetId:'ART'},assets,logo)?.path,logo.path);});
test('canonical/index/follow remain code controlled with all custom fields',()=>{const m=galleryMetadata('https://www.kdcoffee1962.com',logo,{title:'自訂',description:'摘要',ogTitle:'社群',ogDescription:'分享',ogImageAssetId:'ART'},[selected]);assert.deepEqual(m.title,{absolute:'自訂'});assert.deepEqual(m.alternates,{canonical:'https://www.kdcoffee1962.com/gallery'});assert.deepEqual(m.robots,{index:true,follow:true});assert.ok(JSON.stringify(m.openGraph).includes(selected.path));assert.ok(JSON.stringify(m.twitter).includes('社群'));});
const site=JSON.parse(await fs.readFile('public/data/website-data.json','utf8')),works=resolveGalleryWorks(site.menu.products);
test('CollectionPage accepts main copy but keeps generated public ItemList',()=>{const a=galleryStructuredData('https://www.kdcoffee1962.com',works),b=galleryStructuredData('https://www.kdcoffee1962.com',works,{title:'自訂名稱',description:'自訂摘要'});assert.equal(b.name,'自訂名稱');assert.equal(b.description,'自訂摘要');assert.deepEqual(a.mainEntity,b.mainEntity);assert.equal(b.mainEntity.numberOfItems,8);});
test('Admin exposes only four copy inputs, shared asset picker and draft previews',()=>{const html=renderToStaticMarkup(createElement(Controls,{version:1,assets:[logo,selected],onSaved:async()=>{}}));for(const name of ['藝廊搜尋與分享設定','搜尋結果標題','搜尋結果說明','社群分享標題','社群分享描述','從素材庫選擇','搜尋預覽','社群分享預覽'])assert.ok(html.includes(name));assert.ok(html.includes(GALLERY_SEO_TITLE));assert.ok(!html.includes('maxlength'));assert.ok(html.includes('type="file"'));assert.ok(!html.includes('type="url"'));assert.equal((html.match(/<input/g)||[]).length,3);assert.equal((html.match(/<textarea/g)||[]).length,2);});
// 1N baseline is available during this Owner phase; no baseline file is required for future runs.
try{const text=await fs.readFile('qa-output/gallery1n3/before/lib/gallerySeo.ts.snapshot','utf8');const old=await import('data:text/javascript,'+encodeURIComponent(stripTypeScriptTypes(text,{mode:'transform'})));test('default metadata and JSON-LD remain equivalent to approved1N output',()=>{assert.deepEqual(galleryMetadata('https://www.kdcoffee1962.com',logo),old.galleryMetadata('https://www.kdcoffee1962.com',logo));assert.deepEqual(galleryStructuredData('https://www.kdcoffee1962.com',works),old.galleryStructuredData('https://www.kdcoffee1962.com',works));});}catch(error){if((error as NodeJS.ErrnoException).code!=='ENOENT')throw error;}
console.log('GALLERY SEO SETTINGS '+count+' PASS.');
