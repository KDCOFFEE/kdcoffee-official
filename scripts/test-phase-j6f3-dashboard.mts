import assert from 'node:assert/strict';import {createElement} from 'react';import {renderToStaticMarkup} from 'react-dom/server';import {readFileSync} from 'node:fs';import {TodayActions,NotificationStatus} from '../components/admin/AdminDashboard';
const counts={returns:1,manualReturns:1,orders:2,inquiries:2,messages:3,fulfillment:0,unclaimed:0};const html=renderToStaticMarkup(createElement(TodayActions,{counts}));for(const href of ['/admin/returns','/admin/orders','/admin/orders/inquiries','/admin/fulfillment'])assert.ok(html.includes('href="'+href+'"'));assert.equal((html.match(/<a /g)||[]).length,5);assert.equal((html.match(/class="task quiet"/g)||[]).length,2);assert.ok(html.includes('3 則留言等待回覆'));assert.ok(!html.includes('通知'));
for(const failed of [0,2]){const status=renderToStaticMarkup(createElement(NotificationStatus,{notifications:[{status:'pending'},{status:'processing'},...Array.from({length:failed},()=>({status:'failed'}))]}));for(const label of ['通知待發送','通知處理中','通知失敗'])assert.ok(status.includes(label));assert.ok(!status.includes('href=')&&!status.includes('<button'));assert.equal(status.includes('class="warning"'),failed>0);assert.ok(status.includes(failed?'需要後續確認':'目前無通知失敗'));}
const page=readFileSync('app/admin/page.tsx','utf8');for(const expression of ['orders:pending.length','inquiries:pendingInquiries.length','returns:returnOps.total','fulfillment:fulfillmentExceptions','unclaimed:unclaimedRisk','通知']){if(expression!=='通知')assert.ok(page.includes(expression));}assert.ok(page.includes('orders.filter(isActionableOrder)'));assert.ok(page.includes('listPendingOrderInquiries(orders)'));assert.ok(!page.includes('<small>待處理</small>'));assert.ok(page.indexOf('<NotificationStatus')<page.indexOf('LATEST ORDERS'));console.log('DASHBOARD focused assertions PASS: links, counts, zero state, system classification, no fake actions, business hierarchy');
