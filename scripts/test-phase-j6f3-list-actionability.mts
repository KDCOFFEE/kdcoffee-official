type Node={type:unknown;props:Record<string,unknown>};const nodes=(v:unknown):Node[]=>Array.isArray(v)?v.flatMap(nodes):v&&typeof v==="object"&&"props"in v?[v as Node,...nodes((v as Node).props.children)]:[];
const globals=globalThis as typeof globalThis&{__returnHooks?:unknown};let slots:unknown[]=[],cursor=0;
function draw(rows=ownerRows){cursor=0;globals.__returnHooks={useState(initial:unknown){const i=cursor++;if(!(i in slots))slots[i]=initial;return[slots[i],(next:unknown)=>{slots[i]=next;}];}};try{return AdminReturnList({initial:rows});}finally{delete globals.__returnHooks;}}
