 check(def.eventKey+' rejects missing/wrong required fields and omits optional rows',()=>{for(const field of def.fields){const missing:{[key:string]:unknown}={...def.previewSample};delete missing[field.key];const result=renderLineFlex(def.eventKey,missing);if(field.required)assert.equal(result.ok,false);else{assert.ok(result.ok);if(result.ok)assert.ok(!result.card.rows.some(row=>row.key===field.key));}assert.equal(renderLineFlex(def.eventKey,{...def.previewSample,[field.key]:{unsafe:'value'}}).ok,false);}});
 check(def.eventKey+' prohibits private sentinel data',()=>{for(const key of ['bankAccount','refundBank','reason','returnEvidence','attachmentUrl','refundProofUrl','confirmationToken','authToken','fingerprint','environmentSecret','adminNote']){const result=renderLineFlex(def.eventKey,{...def.previewSample,[key]:'PRIVATE-SENTINEL-12345678901234'});assert.equal(result.ok,false);assert.ok(!JSON.stringify(result).includes('PRIVATE-SENTINEL'));}});
