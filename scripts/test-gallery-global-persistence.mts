import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import os from 'node:os';import {atomicWriteJson}from'../lib/jsonFileStore';
const root=await fs.mkdtemp(path.join(os.tmpdir(),'kd-gallery-atmosphere-test-'));const previous=process.env.KD_DATA_DIR;process.env.KD_DATA_DIR=root;
let n=0;async function test(name:string,fn:()=>Promise<void>){await fn();n++;console.log('PASS '+name);}
try{const {getPagesDataFile,getAssetsDataFile}=await import('../lib/storagePaths');const {saveGalleryAtmosphere}=await import('../lib/galleryPageAdminStore');const {readPageStore}=await import('../lib/pageBuilderStore');const pages=getPagesDataFile(),assets=getAssetsDataFile();assert.ok(pages.startsWith(root));await fs.mkdir(path.dirname(pages),{recursive:true});await fs.mkdir(path.dirname(assets),{recursive:true});const original={version:1,updatedAt:'2026-01-01T00:00:00Z',pages:[],systemPages:{unrelated:{sentinel:'keep'}}};await atomicWriteJson(pages,original);await atomicWriteJson(assets,{version:1,updatedAt:'',assets:[{id:'BG-QA',status:'active',path:'/uploads/assets/website/background.webp'},{id:'PRIVATE',status:'active',path:'/uploads/order-notifications/private.webp'}]});
await test('global systemPages save/reload keeps unrelated pages and metadata',async()=>{await saveGalleryAtmosphere(1,{imageAssetId:'BG-QA',strength:30,darkness:60,blur:6});const store=await readPageStore();assert.equal(store.version,2);assert.deepEqual(store.systemPages?.gallery?.atmosphere,{imageAssetId:'BG-QA',strength:30,darkness:60,blur:6});assert.deepEqual(store.systemPages?.unrelated,original.systemPages.unrelated);assert.deepEqual(store.pages,[]);});
await test('stale version fails without overwriting settings',async()=>{const before=await fs.readFile(pages);await assert.rejects(()=>saveGalleryAtmosphere(1,{}));assert.deepEqual(await fs.readFile(pages),before);});
await test('missing/private media rejected before write',async()=>{const before=await fs.readFile(pages);for(const id of ['MISSING','PRIVATE'])await assert.rejects(()=>saveGalleryAtmosphere(2,{imageAssetId:id}));assert.deepEqual(await fs.readFile(pages),before);});
await test('unrelated existing page-store write preserves Gallery reference',async()=>{const store=await readPageStore();const ref=structuredClone(store.systemPages?.gallery);store.systemPages={...store.systemPages,another:{note:'unrelated'}};store.version++;await atomicWriteJson(pages,store);assert.deepEqual((await readPageStore()).systemPages?.gallery,ref);});
await test('removal returns to CSS without deleting an Asset record',async()=>{const before=await fs.readFile(assets);await saveGalleryAtmosphere(3,{strength:25,darkness:55,blur:8});assert.equal((await readPageStore()).systemPages?.gallery?.atmosphere?.imageAssetId,undefined);assert.deepEqual(await fs.readFile(assets),before);});
console.log('GALLERY GLOBAL PERSISTENCE '+n+' PASS; isolated root '+root);
}finally{if(previous===undefined)delete process.env.KD_DATA_DIR;else process.env.KD_DATA_DIR=previous;}
