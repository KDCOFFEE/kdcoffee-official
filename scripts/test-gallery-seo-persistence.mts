import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import os from 'node:os';import {atomicWriteJson} from '../lib/jsonFileStore';
const root=await fs.mkdtemp(path.join(os.tmpdir(),'kd-gallery-seo-test-')),previous=process.env.KD_DATA_DIR;process.env.KD_DATA_DIR=root;let count=0;async function test(name:string,fn:()=>Promise<void>){await fn();count++;console.log('PASS '+name);}
try{
 const {getPagesDataFile,getAssetsDataFile}=await import('../lib/storagePaths');const {saveGallerySeo,saveGalleryAtmosphere,GalleryPageVersionConflictError}=await import('../lib/galleryPageAdminStore');const {readPageStore}=await import('../lib/pageBuilderStore');const pages=getPagesDataFile(),assets=getAssetsDataFile();assert.ok(pages.startsWith(root));await fs.mkdir(path.dirname(pages),{recursive:true});
 const original={version:1,updatedAt:'',pages:[],systemPages:{gallery:{atmosphere:{imageAssetId:'BG',strength:31,darkness:57,blur:8}},other:{keep:'unchanged'}}};await atomicWriteJson(pages,original);await atomicWriteJson(assets,{version:1,updatedAt:'',assets:[{id:'BG',status:'active',path:'/uploads/assets/background.webp'},{id:'OG',status:'active',path:'/uploads/artworks/work/og.webp'},{id:'PRIVATE',status:'active',path:'/uploads/order-notifications/private.webp'}]});
 const value={title:'Owner 的標題',description:'Owner 的摘要',ogTitle:'分享標題',ogDescription:'分享描述',ogImageAssetId:'OG'};
 await test('SEO save/reload preserves atmosphere unrelated system pages and normal pages',async()=>{await saveGallerySeo(1,value);const s=await readPageStore();assert.deepEqual(s.systemPages?.gallery?.seo,value);assert.deepEqual(s.systemPages?.gallery?.atmosphere,original.systemPages.gallery.atmosphere);assert.deepEqual(s.systemPages?.other,original.systemPages.other);assert.deepEqual(s.pages,[]);assert.equal(s.version,2);});
 await test('stale save is rejected without changing any bytes',async()=>{const before=await fs.readFile(pages);await assert.rejects(()=>saveGallerySeo(1,{title:'stale'}),GalleryPageVersionConflictError);assert.deepEqual(await fs.readFile(pages),before);});
 await test('concurrent same-version saves have exactly one winner',async()=>{const attempts=await Promise.allSettled([saveGallerySeo(2,{title:'A'}),saveGallerySeo(2,{title:'B'})]);assert.equal(attempts.filter(a=>a.status==='fulfilled').length,1);assert.equal(attempts.filter(a=>a.status==='rejected').length,1);assert.equal((await readPageStore()).version,3);});
 await test('invalid/private/missing asset and canonical mutation fail before write',async()=>{const before=await fs.readFile(pages);for(const seo of [{ogImageAssetId:'MISSING'},{ogImageAssetId:'PRIVATE'},{canonical:'https://bad.example'},{description:'<script>'}])await assert.rejects(()=>saveGallerySeo(3,seo));assert.deepEqual(await fs.readFile(pages),before);});
 await test('atmosphere save preserves saved SEO, and SEO clear preserves atmosphere',async()=>{const saved=(await readPageStore()).systemPages?.gallery?.seo;await saveGalleryAtmosphere(3,{strength:40,darkness:50,blur:6});assert.deepEqual((await readPageStore()).systemPages?.gallery?.seo,saved);await saveGallerySeo(4,{});assert.deepEqual((await readPageStore()).systemPages?.gallery?.seo,{});assert.deepEqual((await readPageStore()).systemPages?.gallery?.atmosphere,{strength:40,darkness:50,blur:6});});
 console.log('GALLERY SEO PERSISTENCE '+count+' PASS; isolated QA root only.');
}finally{if(previous===undefined)delete process.env.KD_DATA_DIR;else process.env.KD_DATA_DIR=previous;}
