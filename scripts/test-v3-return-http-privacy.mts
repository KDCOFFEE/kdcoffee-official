import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import {runInventoryOrderTransaction} from '../lib/orderInventoryTransaction';
import {withStoredOrderUpdateLock} from '../lib/adminOrders';
import {prepareOrderCompletionWrite} from '../lib/orderCompletion';
const session=JSON.parse(await fs.readFile('qa-output/j6f2c-owner-session.json','utf8'));
assert.equal(session.url,'http://localhost:3188');assert.ok(path.resolve(session.qaRoot).startsWith(path.resolve(os.tmpdir())+path.sep+'kd-j6f2c-owner-'));process.env.KD_DATA_DIR=session.qaRoot;
const orderDir=path.join(session.qaRoot,'orders'),stateFile=path.join(session.qaRoot,'membership-commerce/commerce-state.json');
const before=JSON.parse(await fs.readFile(stateFile,'utf8')),oldOrders=new Map<string,string>();for(const file of await fs.readdir(orderDir))if(file.endsWith('.json'))oldOrders.set(file,await fs.readFile(path.join(orderDir,file),'utf8'));
let checks=0;const check=async(name:string,fn:()=>unknown|Promise<unknown>)=>{await fn();console.log('PASS '+(++checks)+' '+name);};
const applied=before.returnSettlementEvents.find((event:{paymentResult?:{proof:Array<{url:string}>}})=>event.paymentResult?.proof.length),proof=applied.paymentResult.proof[0].url;
const owningOrder=JSON.parse(await fs.readFile(path.join(orderDir,before.returnSettlementEvents.find((event:{effectId:string;plan?:{orderId:string}})=>event.effectId===applied.effectId&&event.plan).plan.orderId+'.json'),'utf8'));
const owner=session.cases.find((item:{memberCookie:string;orderNumber:string})=>JSON.parse(oldOrders.get(item.orderNumber+'.json')!).member.memberId===owningOrder.member.memberId),other=session.cases.find((item:{memberCookie:string})=>item.memberCookie!==owner.memberCookie);assert.ok(owner&&other);
for(const [name,cookie,status]of [['anonymous','',404],['other member',other.memberCookie,404],['owning member',owner.memberCookie,200],['Admin',session.adminCookie,200]] as const)await check('HTTP proof '+name,async()=>{const response=await fetch(session.url+proof,{headers:{Cookie:cookie}});assert.equal(response.status,status);if(status===200)assert.equal(response.headers.get('cache-control'),'private, no-store');});
for(const route of ['/member','/member/orders/'+owner.orderNumber+'/returns','/admin/returns','/admin/returns/'+owner.orderNumber,'/admin/membership'])await check('HTTP page '+route,async()=>{const response=await fetch(session.url+route,{headers:{Cookie:route.startsWith('/admin')?session.adminCookie:owner.memberCookie},redirect:'manual'});assert.equal(response.status,200);});
const id='KD20261030-'+String(Date.now()),at=new Date().toISOString();
const created=await runInventoryOrderTransaction({websiteFile:path.join(session.qaRoot,'store/website-data.json'),orderDir,initialOrderNumber:id,generateOrderNumber:()=>id,items:[{slug:'qa-coffee',optionId:'qa-half-pound',optionLabel:'半磅',quotedUnitPrice:500,quantity:1}],buildOrder:(orderNumber,priced)=>({order:{...priced,orderNumber,createdAt:at,status:'ready_for_pickup',orderMode:'home_delivery',payment:'unsupported_future_method',paymentDetails:{method:'unsupported_future_method',status:'paid'},member:owningOrder.member,customer:{name:'Isolated routing check'},shipping:0,totalBeforeCredit:500,total:500,credit:{appliedAmount:0}},lineText:'isolated'})});assert.ok(created.finalized);
await withStoredOrderUpdateLock(id,async(order,persist)=>persist(await prepareOrderCompletionWrite(order,{...order,status:'completed',fulfillmentEvents:[{eventId:'isolated-complete',state:'completed',occurredAt:at}]}) as typeof order));
const endpoint=(role:string)=>session.url+'/api/'+(role==='member'?'member/orders/'+id+'/returns':'admin/returns/'+id);
const view=await (await fetch(endpoint('member'),{headers:{Cookie:owner.memberCookie}})).json();assert.equal(view.refundMethod,'manual_review_required');
const values={lines:[{returnLineRef:view.lines[0].returnLineRef,quantity:1}],reason:'isolated unsupported routing',conditionAcknowledgement:{itemsComplete:true,unopenedUnusedWhereApplicable:true},quantityAcknowledged:true,refundHandoff:'in_person'};
async function post(role:string,values:unknown){const response=await fetch(endpoint(role),{method:'POST',headers:{Origin:session.url,Cookie:role==='member'?owner.memberCookie:session.adminCookie,'Content-Type':'application/json'},body:JSON.stringify(values)});return {response,data:await response.json()};}
const preview=await post('member',{...values,action:'preview'});assert.equal(preview.response.status,200);
const requested=await post('member',{...values,action:'create',finalConfirmation:true,confirmationToken:preview.data.confirmationToken,idempotencyKey:'unsupported-'+id});assert.equal(requested.response.status,200);const rid=requested.data.returnRequestId;
const approved=await post('admin',{action:'approve',returnRequestId:rid,reason:'isolated review',idempotencyKey:'approve-'+id});assert.equal(approved.response.status,200);
await check('unsupported + in_person remains manual review',async()=>{const result=await (await fetch(endpoint('admin'),{headers:{Cookie:session.adminCookie}})).json();assert.equal(result.requests[0].refundRequest.method,'manual_review_required');assert.equal(result.requests[0].paymentRefund.status,'manual_review_required');});
await check('unsupported cannot confirm cash refund',async()=>assert.ok(!(await post('admin',{action:'refund_confirm',returnRequestId:rid,manuallyPaid:true})).response.ok));
const after=JSON.parse(await fs.readFile(stateFile,'utf8'));
await check('return event prefix preserved',()=>assert.deepEqual(after.returnEvents.slice(0,before.returnEvents.length),before.returnEvents));
await check('settlement event prefix preserved',()=>assert.deepEqual(after.returnSettlementEvents.slice(0,before.returnSettlementEvents.length),before.returnSettlementEvents));
await check('all pre-existing isolated orders byte-identical',async()=>{for(const [file,bytes]of oldOrders)assert.equal(await fs.readFile(path.join(orderDir,file),'utf8'),bytes);});
console.log('INTEGRATED HTTP PRIVACY/ROUTING '+checks+'/'+checks+' PASS; isolated root, existing Owner orders and ledger prefixes preserved.');
