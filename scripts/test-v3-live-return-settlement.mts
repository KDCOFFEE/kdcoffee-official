/** Production-build HTTP QA using only the freshly created disposable QA root. */
import assert from "node:assert/strict";
import fs from "node:fs/promises";
import os from "node:os";
import path from "node:path";
import sharp from "sharp";
import { runInventoryOrderTransaction } from "../lib/orderInventoryTransaction";
import { withStoredOrderUpdateLock } from "../lib/adminOrders";
import { prepareOrderCompletionWrite } from "../lib/orderCompletion";
import { issueCredit, reserveCredit, settleCreditReservation, getAvailableCredit, readMembershipCommerceState } from "../lib/membershipCommerce";
const session = JSON.parse(await fs.readFile("qa-output/j6f2c-owner-session.json", "utf8"));
assert.equal(session.url, "http://localhost:" + Number(process.env.RETURN_REFUND_QA_PORT || 3188));
const root = await fs.realpath(session.qaRoot);
assert.ok(root.startsWith(await fs.realpath(os.tmpdir()) + path.sep + "kd-j6f2c-owner-"));
process.env.KD_DATA_DIR = root; delete process.env.RAILWAY_VOLUME_MOUNT_PATH;
const orderDir = path.join(root, "orders"), stockFile = path.join(root, "store/website-data.json");
const oldOrders = new Map<string, string>();
for (const file of await fs.readdir(orderDir)) if (file.endsWith(".json")) oldOrders.set(file, await fs.readFile(path.join(orderDir, file), "utf8"));
const beforeState = await readMembershipCommerceState();
const user = session.cases[3], ownerOrder = JSON.parse(oldOrders.get(user.orderNumber + ".json")!);
const memberId = ownerOrder.member.memberId, id = "KD20261031-" + Date.now();
const creditBefore = await getAvailableCredit(memberId);
const issued = await issueCredit({ memberId, sourceType: "manual", sourceReference: "isolated-v3:" + id, amount: 50, idempotencyKey: "issue:" + id });
const reservation = await reserveCredit({ memberId, orderId: id, requestedAmount: 50, merchandiseSubtotal: 500, shipping: 0, idempotencyKey: "reserve:" + id });
assert.equal(reservation.amount, 50);
const stock = async () => JSON.parse(await fs.readFile(stockFile, "utf8")).menu.products[0].skus[0].stock as number;
const stockBefore = await stock(), at = new Date().toISOString();
const created = await runInventoryOrderTransaction({ websiteFile: stockFile, orderDir, initialOrderNumber: id, generateOrderNumber: () => id, items: [{ slug: "qa-coffee", optionId: "qa-half-pound", optionLabel: "半磅", quotedUnitPrice: 500, quantity: 1 }], buildOrder: (orderNumber, priced) => ({ order: { ...priced, orderNumber, createdAt: at, status: "ready_for_pickup", orderMode: "711_cod", payment: "cash_on_delivery", paymentDetails: { method: "cash_on_delivery", status: "paid" }, member: ownerOrder.member, customer: { name: "Isolated V3 credited return" }, shipping: 0, totalBeforeCredit: 500, total: 450, credit: { appliedAmount: 50, reservationId: reservation.reservationId, rulesVersion: reservation.rulesVersion } }, lineText: "isolated v3 return QA" }) });
assert.ok(created.finalized); assert.equal(await stock(), stockBefore - 1);
await settleCreditReservation({ reservationId: reservation.reservationId, action: "consume", idempotencyKey: "consume:" + id, reason: "Isolated original completed purchase" });
assert.equal(await getAvailableCredit(memberId), creditBefore);
await withStoredOrderUpdateLock(id, async (order, persist) => persist(await prepareOrderCompletionWrite(order, { ...order, status: "completed", fulfillmentEvents: [{ eventId: "complete:" + id, state: "completed", occurredAt: new Date().toISOString() }] }) as typeof order));
const originalBytes = await fs.readFile(path.join(orderDir, id + ".json"), "utf8");
const png = await sharp({ create: { width: 8, height: 8, channels: 3, background: "white" } }).png().toBuffer();
const photo = () => new File([new Uint8Array(png)], "isolated.png", { type: "image/png" });
const endpoint = (role: "member" | "admin", number = id) => session.url + "/api/" + role + (role === "member" ? "/orders/" : "/returns/") + number + (role === "member" ? "/returns" : "");
async function get(role: "member" | "admin", number = id) { const r = await fetch(endpoint(role, number), { headers: { Cookie: role === "member" ? user.memberCookie : session.adminCookie } }); assert.equal(r.status, 200); return r.json(); }
async function post(role: "member" | "admin", values: Record<string, unknown>, image?: File) { const form = new FormData(); form.set("payload", JSON.stringify(values)); if (image) form.set("photos", image); const r = await fetch(endpoint(role), { method: "POST", headers: { Origin: session.url, Cookie: role === "member" ? user.memberCookie : session.adminCookie, ...(!image ? { "Content-Type": "application/json" } : {}) }, body: image ? form : JSON.stringify(values) }); const body = await r.json(); assert.equal(r.status, 200, JSON.stringify(body)); return body; }
const view = await get("member"); assert.equal(view.eligible, true);
const values = { lines: [{ returnLineRef: view.lines[0].returnLineRef, quantity: 1 }], reason: "隔離 QA 商品照片", conditionAcknowledgement: { itemsComplete: true, unopenedUnusedWhereApplicable: true }, quantityAcknowledged: true, refundHandoff: "seven_eleven", refundBank: { bank: "822｜中國信託商業銀行", holder: "Isolated QA", account: "12345678901234", branch: "" } };
const preview = await post("member", { ...values, action: "preview" }); assert.equal(preview.preview.returnCreditAmount, 50); assert.equal(preview.paymentPreview.amount, 450);
const createValues = { ...values, action: "create", finalConfirmation: true, confirmationToken: preview.confirmationToken, idempotencyKey: "return:" + id };
const requested = await post("member", createValues, photo());
const rid = requested.returnRequestId; assert.ok(rid);
assert.equal((await post("member", createValues, photo())).replayed, true);
const approve = { action: "approve", returnRequestId: rid, reason: "Isolated Admin approval", idempotencyKey: "approve:" + id };
await post("admin", approve);
assert.equal(await stock(), stockBefore); assert.equal(await getAvailableCredit(memberId), creditBefore + 50);
const approved = await get("member"); assert.equal(approved.requests[0].creditSettlement.restoredAmount, 50); assert.equal(approved.requests[0].creditSettlement.entries[0].expiresAt, issued.expiresAt);
await post("admin", approve); assert.equal(await stock(), stockBefore); assert.equal(await getAvailableCredit(memberId), creditBefore + 50);
const confirm = { action: "refund_confirm", returnRequestId: rid, manuallyPaid: true };
const paid = await post("admin", confirm, photo()); assert.equal(paid.additionalRefund, 450);
assert.equal((await post("admin", confirm)).additionalRefund, 0);
await post("admin", { action: "refund_notify", returnRequestId: rid });
const final = await get("member"); assert.equal(final.requests[0].paymentRefund.status, "completed"); assert.equal(final.requests[0].paymentRefund.amount, 450); assert.equal(final.requests[0].paymentRefund.notification, "failed"); assert.equal(final.requests[0].paymentRefund.proof.length, 1); assert.equal(JSON.stringify(final).includes("12345678901234"), false);
assert.equal(await stock(), stockBefore); assert.equal(await getAvailableCredit(memberId), creditBefore + 50);
assert.equal(await fs.readFile(path.join(orderDir, id + ".json"), "utf8"), originalBytes);
// Missing historical completion/financial evidence is never guessed or backfilled.
const legacyId = "KD20261031-" + (Date.now() + 1);
await fs.writeFile(path.join(orderDir, legacyId + ".json"), JSON.stringify({ orderNumber: legacyId, status: "completed", member: ownerOrder.member, items: [{ slug: "unknown-history", quantity: 1 }], total: 100 }));
assert.equal((await get("member", legacyId)).eligibility, "manual_review_required");
const after = await readMembershipCommerceState();
assert.deepEqual(after.returnEvents?.slice(0, beforeState.returnEvents?.length ?? 0), beforeState.returnEvents ?? []);
assert.deepEqual(after.returnSettlementEvents?.slice(0, beforeState.returnSettlementEvents?.length ?? 0), beforeState.returnSettlementEvents ?? []);
for (const [file, bytes] of oldOrders) assert.equal(await fs.readFile(path.join(orderDir, file), "utf8"), bytes);
console.log("V3 LIVE SETTLEMENT PASS: photo request -> approval -> stock +1 -> original-expiry credit +50 -> TWD 450 -> proof -> completed Member DTO; all retries +0; LINE failure independent; historical manual review; prior orders/ledger prefixes preserved.");
