import assert from 'node:assert/strict';import {createGalleryRevealClock,galleryParts,type GalleryPlayback}from'../lib/galleryReveal';import type{GalleryRevealTiming}from'../lib/galleryRevealTiming';
let n=0;const test=(name:string,fn:()=>void)=>{fn();n++;console.log('PASS '+name);};const owner={titleHookAt:5.8,interpretationAt:5,coffeeBridgeAt:3.4,ctaAt:6};
function fixture(timing?:GalleryRevealTiming){let now=0,id=0,parts=galleryParts(false),position=0,readable=true;const timers=new Map<number,{at:number;fn:()=>void}>();const clock=createGalleryRevealClock(()=>{},{now:()=>now,set:(fn,delay)=>{const key=++id;timers.set(key,{at:now+delay,fn});return key as unknown as ReturnType<typeof setTimeout>;},clear:key=>{timers.delete(key as unknown as number);}},timing,next=>{parts=next;});const readProgress=()=>readable?position:undefined;return{clock,readProgress,get parts(){return parts;},get pending(){return timers.size;},set position(value:number){position=value;},set readable(value:boolean){readable=value;},update(mode:GalleryPlayback['mode']){clock.update({mode,duration:8,readProgress});},advance(ms:number){const end=now+ms;for(;;){const next=[...timers.entries()].sort((a,b)=>a[1].at-b[1].at)[0];if(!next||next[1].at>end)break;now=next[1].at;timers.delete(next[0]);next[1].fn();}now=end;}};}
const s=fixture(owner);s.update('static');test('static initially hides all blocks and owns one timer',()=>{assert.deepEqual(s.parts,galleryParts(false));assert.equal(s.pending,1);});
test('Owner coffee bridge reveals first at3.4, not title',()=>{s.advance(3399);assert.equal(s.parts.coffeeBridge,false);s.advance(1);assert.equal(s.parts.coffeeBridge,true);assert.equal(s.parts.titleHook,false);assert.equal(s.parts.interpretation,false);});
test('interpretation at5.0 preserves configured order',()=>{s.advance(1600);assert.equal(s.parts.interpretation,true);assert.equal(s.parts.titleHook,false);});
test('title/hook at5.8 and CTA at6.0 are independent',()=>{s.advance(800);assert.equal(s.parts.titleHook,true);assert.equal(s.parts.cta,false);s.advance(200);assert.deepEqual(s.parts,galleryParts(true));assert.equal(s.pending,0);});
test('new static work starts fresh',()=>{s.clock.dispose();const next=fixture(owner);next.update('static');assert.deepEqual(next.parts,galleryParts(false));});
test('hidden static stage freezes elapsed and resumes without a jump',()=>{const f=fixture(owner);f.update('static');f.advance(1000);f.clock.setHidden(true);assert.equal(f.pending,0);f.advance(600000);assert.equal(f.parts.coffeeBridge,false);f.clock.setHidden(false);assert.equal(f.pending,1);f.advance(2399);assert.equal(f.parts.coffeeBridge,false);f.advance(1);assert.equal(f.parts.coffeeBridge,true);});
test('early reveal overrides the remaining timeline',()=>{const f=fixture(owner);f.update('static');f.advance(500);f.clock.reveal();assert.deepEqual(f.parts,galleryParts(true));assert.equal(f.pending,0);});
test('default static timing remains3.5/5 seconds',()=>{const f=fixture();f.update('static');f.advance(3499);assert.equal(f.parts.titleHook,false);f.advance(1);assert.equal(f.parts.titleHook,true);f.advance(1500);assert.deepEqual(f.parts,galleryParts(true));});
test('video does not advance from wall time while native progress is stalled',()=>{const f=fixture(owner);f.update('playing');f.advance(12000);assert.equal(f.parts.coffeeBridge,false);f.position=3.4;f.advance(40);assert.equal(f.parts.coffeeBridge,true);assert.equal(f.parts.interpretation,false);});
test('loading and paused video do not consume reveal time',()=>{const f=fixture(owner);f.update('pending');f.advance(10000);assert.equal(f.pending,0);f.update('playing');f.position=2;f.advance(40);f.update('paused');f.advance(10000);assert.equal(f.parts.coffeeBridge,false);f.update('playing');f.position=3.4;f.advance(40);assert.equal(f.parts.coffeeBridge,true);});
test('autoplay failure starts static elapsed rather than showing all',()=>{const f=fixture(owner);f.update('pending');f.advance(9000);f.update('static');assert.deepEqual(f.parts,galleryParts(false));f.advance(3400);assert.equal(f.parts.coffeeBridge,true);assert.equal(f.parts.titleHook,false);});
test('error after native playback continues from accumulated time',()=>{const f=fixture(owner);f.update('playing');f.position=4;f.advance(40);assert.equal(f.parts.coffeeBridge,true);f.update('static');assert.equal(f.parts.interpretation,false);f.advance(1000);assert.equal(f.parts.interpretation,true);assert.equal(f.parts.titleHook,false);f.advance(800);assert.equal(f.parts.titleHook,true);});
test('fallback never hides an already revealed adapted block',()=>{const f=fixture(owner);f.clock.update({mode:'playing',duration:2,readProgress:f.readProgress});f.position=.9;f.advance(40);assert.equal(f.parts.coffeeBridge,true);f.update('static');assert.equal(f.parts.coffeeBridge,true);assert.equal(f.parts.cta,false);});
test('save-data static presentation keeps configured delays',()=>{const f=fixture(owner);f.update('static');f.advance(3000);assert.equal(f.parts.coffeeBridge,false);f.advance(400);assert.equal(f.parts.coffeeBridge,true);});
test('reduced-motion is the immediate accessibility exception',()=>{const f=fixture(owner);f.update('static');f.update('reduced');assert.deepEqual(f.parts,galleryParts(true));assert.equal(f.pending,0);});
test('hidden video position jumps do not consume active reveal time',()=>{const f=fixture(owner);f.update('playing');f.position=1;f.advance(40);f.clock.setHidden(true);f.position=60;f.advance(60000);f.clock.setHidden(false);assert.equal(f.parts.coffeeBridge,false);f.position=62.4;f.advance(40);assert.equal(f.parts.coffeeBridge,true);});
test('rapid switches and disposal leave no clock behind',()=>{for(let i=0;i<100;i++){const f=fixture(owner);f.update(i%2?'playing':'static');assert.equal(f.pending,1);f.clock.dispose();assert.equal(f.pending,0);f.advance(10000);assert.deepEqual(f.parts,galleryParts(false));}});
console.log('GALLERY H STATIC/NATIVE CLOCK '+n+' PASS; virtual monotonic time, no intervals/network/data writes.');
