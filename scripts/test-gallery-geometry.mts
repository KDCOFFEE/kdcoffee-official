import assert from 'node:assert/strict';import fs from 'node:fs/promises';
const css=await fs.readFile('components/gallery/GalleryExperience.module.css','utf8'),page=await fs.readFile('app/gallery/page.tsx','utf8');let count=0;
function test(name:string,fn:()=>void){fn();count++;console.log('PASS '+name);}
test('compact Header is opt-in only on Gallery',()=>{assert.ok(page.includes('<div className={css.headerChrome}><Header publicProductsOnly/></div>'));assert.ok(css.includes('.headerChrome :global(.v2-header) { height:70px'));assert.ok(css.includes('.page { padding-top:70px'));assert.ok(css.includes('.page { padding-top:62px'));});
test('room-relative centered width with bounded maximum and no reserved column',()=>{assert.ok(css.includes('.shell { width:92%; max-width:1880px; margin-inline:auto'));assert.ok(css.includes('.stageColumn { min-width:0; width:100%; margin-inline:auto'));assert.ok(css.includes('.cinematicStage { position:relative; width:100%; margin-inline:auto'));assert.ok(!css.includes('grid-template-columns'));});
test('sequence and arrows float without affecting stage flow',()=>{assert.ok(css.includes('.sequence { position:absolute'));assert.ok(css.includes('.sequence { top:20px; right:24px; width:max-content; pointer-events:none; }'));assert.ok(css.includes('.stageControls button { position:absolute'));assert.ok(css.includes('.exhibition .stageControls button:first-child { left:-22px; }'));assert.ok(css.includes('.exhibition .stageControls button:last-child { right:-22px; }'));});
test('uncropped centered media, overlay copy and icon-only dimensions retained',()=>{for(const s of ['object-position:center','object-fit:contain','background:#211a14','position:absolute; right:36px','width:34px; height:34px','width:32px; height:32px'])assert.ok(css.includes(s));});
test('public desktop stage is intrinsically sized with overlays on actual media',()=>{for(const s of ['.exhibition .stageAndDetails { width:fit-content; max-width:100%; margin-inline:auto; }','.exhibition .media { height:auto; min-height:0; max-height:none; background:transparent; border:0; }','.exhibition .media > video { position:relative; inset:auto; display:block; width:auto; height:auto;','.exhibition .stageControls button { top:50%; transform:translateY(-50%); }'])assert.ok(css.includes(s));});
console.log('GALLERY GEOMETRY '+count+' PASS; measured browser geometry verified separately.');
