/** Real HTTP operations QA confined to the existing fresh temporary Owner QA root. */
import assert from "node:assert/strict";
import fs from "node:fs/promises";
import os from "node:os";
import path from "node:path";
import {runInventoryOrderTransaction} from "../lib/orderInventoryTransaction";
import {withStoredOrderUpdateLock} from "../lib/adminOrders";
import {prepareOrderCompletionWrite} from "../lib/orderCompletion";
import {readMembershipCommerceState} from "../lib/membershipCommerce";
const session=JSON.parse(await fs.readFile("qa-output/j6f2c-owner-session.json","utf8"));assert.equal(session.url,"http://localhost:"+Number(process.env.RETURN_REFUND_QA_PORT||3193));
const root=await fs.realpath(session.qaRoot);assert.ok(root.startsWith(await fs.realpath(os.tmpdir())+path.sep+"kd-j6f2c-owner-"));process.env.KD_DATA_DIR=root;for(const k of Object.keys(process.env))if(/^(RAILWAY_|LINE_|GMAIL_|GOOGLE_|SMTP_|RESEND_)/.test(k))delete process.env[k];
const orderDir=path.join(root,"orders"),oldFiles=new Map<string,string>();for(const f of await fs.readdir(orderDir))if(f.endsWith(".json"))oldFiles.set(f,await fs.readFile(path.join(orderDir,f),"utf8"));const before=await readMembershipCommerceState();
const owner=session.cases[3],seed=JSON.parse(oldFiles.get(owner.orderNumber+".json")!),bank={bank:"822｜中國信託商業銀行",holder:"QA Member",account:"12345678901234",branch:""},cases:Array<{orderNumber:string;admin:string;member:string;state:string}>=[];
async function page(route:string){const r=await fetch(session.url+route,{headers:{Cookie:session.adminCookie}});assert.equal(r.status,200,route);return r.text();}
const homeBefore=await page("/admin");assert.ok(homeBefore.includes("待處理退貨"));
async function make(state:"cash-completed"|"bank-completed"|"owner-review"){
 const id="KD20261031-"+Date.now(),now=new Date().toISOString();const created=await runInventoryOrderTransaction({websiteFile:path.join(root,"store/website-data.json"),orderDir,initialOrderNumber:id,generateOrderNumber:()=>id,items:[{slug:"qa-coffee",optionId:"qa-half-pound",optionLabel:"半磅",quantity:1,quotedUnitPrice:500}],buildOrder:(orderNumber,priced)=>({order:{...priced,orderNumber,createdAt:now,status:"ready_for_pickup",orderMode:"home_delivery",payment:"unknown",paymentDetails:{method:"unknown",status:"paid"},member:seed.member,customer:{name:"J6F3 隔離人工確認"},shipping:0,codServiceFee:0,totalBeforeCredit:500,total:500,credit:{appliedAmount:0}},lineText:"isolated J6F3"})});assert.ok(created.finalized);
 await withStoredOrderUpdateLock(id,async(order,persist)=>persist(await prepareOrderCompletionWrite(order,{...order,status:"completed"}) as typeof order));const original=await fs.readFile(path.join(orderDir,id+".json"),"utf8");
 const endpoint=(role:"member"|"admin")=>session.url+"/api/"+role+(role==="member"?"/orders/":"/returns/")+id+(role==="member"?"/returns":"");
 async function get(role:"member"|"admin"){const r=await fetch(endpoint(role),{headers:{Cookie:role==="member"?owner.memberCookie:session.adminCookie}});assert.equal(r.status,200);return r.json();}
 async function post(role:"member"|"admin",values:Record<string,unknown>,status=200){const r=await fetch(endpoint(role),{method:"POST",headers:{Origin:session.url,Cookie:role==="member"?owner.memberCookie:session.adminCookie,"Content-Type":"application/json"},body:JSON.stringify(values)});const body=await r.json();assert.equal(r.status,status,JSON.stringify(body));return body;}
 const eligible=await get("member"),values={lines:[{returnLineRef:eligible.lines[0].returnLineRef,quantity:1}],reason:"隔離 QA 商品破損",conditionAcknowledgement:{itemsComplete:true,unopenedUnusedWhereApplicable:true},quantityAcknowledged:true,refundHandoff:"courier"};const preview=await post("member",{...values,action:"preview"});const requested=await post("member",{...values,action:"create",finalConfirmation:true,confirmationToken:preview.confirmationToken,idempotencyKey:"request:"+id});const rid=requested.returnRequestId;
 const approval={action:"approve",returnRequestId:rid,reason:"PRIVATE OWNER NOTE",idempotencyKey:"approve:"+id};await post("admin",approval);await post("admin",approval);const review=await get("admin");assert.equal(review.requests[0].paymentRefund.status,"manual_review_required");assert.equal(review.requests[0].paymentRefund.reviewAmount,500);assert.equal(review.requests[0].paymentRefund.reviewResolvable,true);
 const html=await page("/admin/returns/"+id);assert.ok(html.includes("人工確認退款方式"));assert.ok(html.includes("NT$500"));assert.ok(!html.includes(bank.account));
 if(state!=="owner-review"){
 const method=state==="cash-completed"?"manual_cash":"manual_bank_transfer",resolution={action:"refund_review_resolve",returnRequestId:rid,method,note:"Owner checked synthetic payment",acknowledged:true,idempotencyKey:"resolve:"+id,...(method==="manual_bank_transfer"?{bank,bankAcknowledged:true}:{})};
 await post("admin",{...resolution,acknowledged:false},400);await post("admin",resolution);await post("admin",resolution);const ready=await get("admin");assert.equal(ready.requests[0].paymentRefund.status,"pending");assert.ok(!JSON.stringify(ready).includes(bank.account));const details=await post("admin",{action:"refund_details",returnRequestId:rid});assert.equal(details.bank?.account??null,method==="manual_bank_transfer"?bank.account:null);
 const confirm={action:"refund_confirm",returnRequestId:rid,manuallyPaid:true};assert.equal((await post("admin",confirm)).additionalRefund,500);assert.equal((await post("admin",confirm)).additionalRefund,0);await post("admin",{action:"refund_notify",returnRequestId:rid});const member=await get("member");assert.equal(member.requests[0].paymentRefund.status,"completed");assert.equal(member.requests[0].paymentRefund.amount,500);assert.equal(member.requests[0].paymentRefund.notification,"failed");for(const secret of [bank.account,"PRIVATE OWNER NOTE","Owner checked synthetic payment"])assert.ok(!JSON.stringify(member).includes(secret));
 }
 assert.equal(await fs.readFile(path.join(orderDir,id+".json"),"utf8"),original);cases.push({orderNumber:id,admin:session.url+"/admin/returns/"+id,member:session.url+"/member/orders/"+id+"/returns",state});
}
for(const state of ["cash-completed","bank-completed","owner-review"] as const)await make(state);
const home=await page("/admin");assert.ok(home.includes("待處理退貨"));assert.ok(home.replace(/<!--[\s\S]*?-->/g,"").includes("人工確認 1"));const settings=await page("/admin/membership");for(const label of ["收到退貨申請（通知管理者）","退貨申請已收到（通知會員）","退貨申請已核准（通知會員）","退貨申請未核准（通知會員）","退款完成（通知會員）"])assert.ok(settings.includes(label));
const after=await readMembershipCommerceState();assert.deepEqual(after.returnEvents?.slice(0,before.returnEvents?.length??0),before.returnEvents??[]);assert.deepEqual(after.returnSettlementEvents?.slice(0,before.returnSettlementEvents?.length??0),before.returnSettlementEvents??[]);for(const [file,bytes]of oldFiles)assert.equal(await fs.readFile(path.join(orderDir,file),"utf8"),bytes);
await fs.writeFile("qa-output/j6f3-final/owner-cases.json",JSON.stringify({url:session.url,cases,adminLogin:session.url+"/__qa/admin/4",memberLogin:session.url+"/__qa/member/4",productionMutations:0,realNotifications:0},null,2));
console.log("J6F3 LIVE HTTP PASS: canonical home badge/settings; unknown original payment -> audited cash/bank -> NT$500 complete -> retry +0 -> notification-only resend; Member masks; prior Owner orders and both ledger prefixes unchanged; pending manual-review case retained for Owner.");
