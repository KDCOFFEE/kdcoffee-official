import assert from 'node:assert/strict';import fs from 'node:fs/promises';import {createElement} from 'react';import {renderToStaticMarkup} from 'react-dom/server';
import type {CoffeeArtwork} from '../data/websiteData';import {resolveGalleryWorks} from '../lib/galleryWorks';import {resolveWorksProductListing} from '../lib/productListing';import GalleryExperience from '../components/gallery/GalleryExperience';
let checks=0;function test(name:string,run:()=>void){run();checks++;console.log('PASS '+name);}
const site=JSON.parse(await fs.readFile('public/data/website-data.json','utf8'));const products=site.menu.products as CoffeeArtwork[];const before=JSON.stringify(products),works=resolveGalleryWorks(products);
test('same public visibility and curated order as Works',()=>assert.deepEqual(works.map(w=>w.slug),resolveWorksProductListing(products).map(p=>p.slug)));
test('projection never mutates original public data',()=>assert.equal(JSON.stringify(products),before));
test('no private commerce fields leave adapter',()=>{for(const work of works)for(const key of ['price','purchase','skus','stock','inventory','member','payment','order'])assert.ok(!Object.hasOwn(work,key));});
test('first active work is canonical deterministic first work',()=>assert.equal(works[0].slug,resolveWorksProductListing(products)[0].slug));
test('zero public works controlled empty state',()=>{const html=renderToStaticMarkup(createElement(GalleryExperience,{works:[]}));assert.ok(html.includes('展覽正在準備中'));});
test('one work hides unnecessary next/previous',()=>{const html=renderToStaticMarkup(createElement(GalleryExperience,{works:works.slice(0,1)}));assert.ok(!html.includes('aria-label="下一支作品"'));assert.ok(html.includes('/works/'+works[0].slug));});
test('all canonical detail links available without JS',()=>{const html=renderToStaticMarkup(createElement(GalleryExperience,{works}));for(const work of works)assert.ok(html.includes('/works/'+work.slug));assert.equal((html.match(/<h2/g)||[]).length,1);});
test('SSR never mounts autoplay or all video sources',()=>{const html=renderToStaticMarkup(createElement(GalleryExperience,{works:works.map(w=>({...w,stageVideo:'/videos/test.mp4'}))}));assert.ok(!html.includes('<video'));});
test('no second detail route or purchase controls',()=>{const html=renderToStaticMarkup(createElement(GalleryExperience,{works}));assert.ok(!html.includes('/gallery/'));assert.ok(!html.includes('加入購物車'));});
test('hidden/discontinued and unlisted works never exposed',()=>{const base=products[0];assert.equal(resolveGalleryWorks([{...base,status:'hidden'},{...base,status:'discontinued'},{...base,inMonthlyMenu:false}]).length,0);});
test('sold-out listing honors existing showWhenSoldOut policy',()=>{const base=products[0];assert.equal(resolveGalleryWorks([{...base,status:'sold_out',showWhenSoldOut:false}]).length,0);assert.equal(resolveGalleryWorks([{...base,status:'sold_out',showWhenSoldOut:true}]).length,1);});
test('equal-sort stable order and 30+ works supported',()=>{const large=Array.from({length:35},(_,i)=>({...products[0],slug:'sample-'+i,sort:0}));assert.deepEqual(resolveGalleryWorks(large).map(w=>w.slug),large.map(p=>p.slug));const html=renderToStaticMarkup(createElement(GalleryExperience,{works:resolveGalleryWorks(large)}));assert.ok(html.includes('共 35 支'));});
test('dedicated Gallery video preserves original metadata source and poster',()=>{const base={...products[0],assets:{galleryDesktopAnimation:{path:'/uploads/artworks/test/poster.webp',media:{type:'video' as const,url:'https://res.cloudinary.com/example/video/upload/test.mp4',posterUrl:'/uploads/artworks/test/poster.webp'}}}};const result=resolveGalleryWorks([base])[0];assert.equal(result.stageVideo,base.assets.galleryDesktopAnimation.media.url);assert.equal(result.posterImage,base.assets.galleryDesktopAnimation.media.posterUrl);});
test('private/unsafe media rejected without borrowing unrelated media',()=>{for(const source of ['javascript:alert(1)','//evil.test/x.mp4','https://evil.test/x.mp4','/uploads/order-notifications/x.mp4','/uploads/artworks/../private.mp4','/uploads/artworks/%2e%2e/private.mp4']){const base={...products[0],assets:{galleryDesktopAnimation:{media:{type:'video' as const,url:source}}}};assert.equal(resolveGalleryWorks([base])[0].stageVideo,'');}});
test('missing title/image uses intentional editorial fallback',()=>{const base={...products[0],name:'',assets:{},cover:'',poster:''};const result=resolveGalleryWorks([base])[0];assert.equal(result.title,'咖啡作品');assert.equal(result.stageImage,'');const html=renderToStaticMarkup(createElement(GalleryExperience,{works:[result]}));assert.ok(html.includes('作品視覺準備中'));assert.ok(!html.includes('src=""'));});
test('absent English title omitted rather than invented',()=>{assert.equal(resolveGalleryWorks([{...products[0],nameEn:''}])[0].englishTitle,'');});
test('Gallery projection and presentation omit product specification fields',()=>{const result=resolveGalleryWorks([products[0]])[0];for(const key of ['origin','process','roastLevel'])assert.ok(!Object.hasOwn(result,key));const html=renderToStaticMarkup(createElement(GalleryExperience,{works:[result]}));for(const label of ['產區','處理法','焙度'])assert.ok(!html.includes(label));assert.ok(html.includes('走進作品'));});
console.log('GALLERY.1 '+checks+' focused data/SSR/accessibility checks PASS; no writes or network.');
