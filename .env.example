NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Transactional emails reuse the existing Resend sender (server-side only).
RESEND_API_KEY=
MEMBER_EMAIL_FROM=
# Preferred origin for member/order email links; falls back to NEXT_PUBLIC_SITE_URL.
MEMBER_SITE_URL=
# Optional owner-approved official customer LINE HTTPS URL. No guessed default.
# Missing/invalid value omits the contact button without preventing email delivery.
CUSTOMER_SUPPORT_LINE_URL=
# Production persistent storage root. Leave unset for current local-development paths.
# Railway: mount the service volume at /data and set KD_DATA_DIR=/data.
KD_DATA_DIR=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
# INTERNAL: old "KD咖啡訂單傳送" Bot, for operational/admin alerts only.
LINE_INTERNAL_CHANNEL_ACCESS_TOKEN=
LINE_INTERNAL_RECIPIENT_ID=
# CUSTOMER: @kdcoffee, for customer/member Messaging API notifications.
LINE_CUSTOMER_CHANNEL_ACCESS_TOKEN=
# DEPRECATED / LEGACY fallback only. Remove after Railway migration is complete.
# Neither adapter falls back to the other adapter's canonical token.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ORDER_RECIPIENT_ID=
ADMIN_PASSWORD=replace-this-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
